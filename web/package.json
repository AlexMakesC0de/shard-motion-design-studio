{
  "name": "motion-design-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Shard's local studio web app. The server has no dependencies; the page is built with Vite.",
  "scripts": {
    "build": "vite build",
    "codex-protocol": "node scripts/codex-protocol.mjs",
    "dev": "vite",
    "test": "npm run test:server && npm run test:page",
    "test:server": "node --test 'tests/*.test.mjs'",
    "test:page": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
