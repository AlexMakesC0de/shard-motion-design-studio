{
  "name": "motion-design",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Shard: a local motion-design studio, CLI and MCP server for AI video and images over kie.ai.",
  "bin": {
    "kie": "./cli/kie.mjs"
  },
  "scripts": {
    "test": "node --test 'tests/*.test.mjs'",
    "test:mcp": "npm --prefix mcp test",
    "studio": "node web/server/main.mjs",
    "test:web": "npm --prefix web test",
    "doctor": "node cli/kie.mjs doctor",
    "validate": "python3 skills/motion-design/scripts/build_gallery.py",
    "install-skill": "node install.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
